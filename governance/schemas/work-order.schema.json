{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.schnittbuild-stack.example/aef/work-order.schema.json",
  "title": "Autopilot Kit Work Order",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "risk_class", "business_outcome", "repository_context", "in_scope", "out_of_scope", "file_allowlist", "validation", "rollback", "execution_budget", "approval", "acceptance_review"],
  "properties": {
    "id": {"type": "string", "pattern": "^WO-[0-9]{8}-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "executing", "verified", "closed"]},
    "risk_class": {"enum": ["A", "B", "C", "D", "X"]},
    "business_outcome": {"type": "string", "minLength": 1},
    "repository_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "base_commit"],
      "properties": {
        "repository": {"const": "schnittbuild-stack/Autopilot-Kit-Pro"},
        "branch": {"type": "string", "pattern": "^(?!main$).+"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "file_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "string", "minLength": 1},
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effort_class", "host_token_budget", "max_builder_rounds", "max_review_rounds", "max_parallel_readers", "full_regression_runs", "context_mode", "on_exhaustion"],
      "properties": {
        "effort_class": {"enum": ["small", "standard", "large"]},
        "host_token_budget": {"type": ["integer", "null"], "minimum": 1000, "maximum": 500000},
        "max_builder_rounds": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_review_rounds": {"type": "integer", "minimum": 1, "maximum": 2},
        "max_parallel_readers": {"type": "integer", "minimum": 0, "maximum": 2},
        "full_regression_runs": {"const": 1},
        "context_mode": {"const": "minimum_necessary"},
        "on_exhaustion": {"const": "stop_and_replan"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver_subject", "issued_at", "valid_until", "payload_sha256", "proof_ref"],
      "properties": {
        "approver_subject": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "proof_ref": {"type": "string", "minLength": 1}
      }
    },
    "acceptance_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reviewer_subject", "reviewed_at", "reviewed_payload_sha256", "reviewed_scope_sha256", "evidence_ref"],
      "properties": {
        "verdict": {"enum": ["PENDING", "PASS", "FAIL"]},
        "reviewer_subject": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "reviewed_payload_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "reviewed_scope_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "evidence_ref": {"type": ["string", "null"]}
      }
    }
  }
}
